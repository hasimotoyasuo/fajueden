---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventHero from "../components/EventHero.astro";
import EventCard from "../components/EventCard.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import EventFAQ from "../components/EventFAQ.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { marketEvents } from "../data/markets";
import { siteConfig } from "../config/site";

const upcomingEvent = marketEvents.find((e) => e.isUpcoming) ?? marketEvents[0];
---

<BaseLayout
  title="Events — FAJU EDEN"
  description="Farm events in Kakamega — farmers markets, farm tours, workshops and more."
>
  <EventHero />

  {upcomingEvent && <EventCard event={upcomingEvent} />}

  <PhotoGallery />
  <EventFAQ />

  <!-- WhatsApp CTA -->
  <section class="py-16 md:py-24 bg-eden-green">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="font-display text-3xl md:text-4xl text-eden-cream mb-4">
        Have Questions?
      </h2>
      <p class="text-eden-cream/80 mb-8">
        Reach out to us on WhatsApp for more information about
        upcoming events, participation, or anything else.
      </p>
      <WhatsAppButton
        message={siteConfig.whatsapp.marketMessage}
        label="Chat with Us on WhatsApp"
        variant="light"
      />
    </div>
  </section>
</BaseLayout>

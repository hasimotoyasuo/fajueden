---
import WhatsAppButton from "./WhatsAppButton.astro";
import { siteConfig } from "../config/site";
---

<footer class="bg-eden-green text-eden-cream">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Brand -->
      <div>
        <h3 class="font-display text-2xl mb-3">{siteConfig.name}</h3>
        <p class="text-eden-cream/70 text-sm leading-relaxed">
          {siteConfig.tagline}
        </p>
        <p class="text-eden-cream/50 text-sm mt-2">{siteConfig.location}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold mb-4 text-eden-cream/90">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/"
              class="text-eden-cream/70 hover:text-eden-terra transition-colors"
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/event"
              class="text-eden-cream/70 hover:text-eden-terra transition-colors"
            >
              Events
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-eden-cream/70 hover:text-eden-terra transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="text-eden-cream/70 hover:text-eden-terra transition-colors"
            >
              Facebook
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold mb-4 text-eden-cream/90">Get in Touch</h4>
        <p class="text-eden-cream/70 text-sm mb-2">
          Have questions or want to order? Reach out on WhatsApp:
        </p>
        <p class="text-eden-cream font-semibold text-base mb-4">
          {siteConfig.whatsapp.displayNumber}
        </p>
        <WhatsAppButton
          message={siteConfig.whatsapp.defaultMessage}
          label="Chat on WhatsApp"
          variant="light"
        />
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-eden-forest text-center">
      <p class="text-eden-cream/50 text-sm">
        &copy; {new Date().getFullYear()} {siteConfig.name}. All rights
        reserved.
      </p>
    </div>
  </div>
</footer>

---
import type { MarketEvent } from "../data/markets";
import WhatsAppButton from "./WhatsAppButton.astro";
import { siteConfig } from "../config/site";

interface Props {
  event: MarketEvent;
}

const { event } = Astro.props;
---

<section class="py-16 md:py-24 bg-eden-sand">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="font-display text-3xl md:text-4xl text-eden-green text-center mb-12">
      Next Event
    </h2>
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
      <div class="bg-eden-green px-6 py-4 flex flex-wrap items-center justify-between gap-2">
        <span class="inline-block bg-eden-terra text-eden-cream text-sm font-semibold px-3 py-1 rounded-full">
          {event.isUpcoming ? "Upcoming" : "Past Event"}
        </span>
        {event.partner && (
          <span class="text-eden-cream/80 text-sm font-medium">
            In partnership with {event.partner}
          </span>
        )}
      </div>
      <div class="p-6 md:p-8">
        <h3 class="font-display text-2xl text-eden-green mb-3">{event.title}</h3>
        {event.description && (
          <p class="text-eden-dark/70 leading-relaxed mb-5">
            {event.description}
          </p>
        )}
        <div class="space-y-3 text-eden-dark/80 mb-6">
          <div class="flex items-start gap-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 mt-0.5 text-eden-forest shrink-0">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4M8 2v4M3 10h18" />
            </svg>
            <span>
              {event.dates}
              {event.time ? ` · ${event.time}` : ""}
            </span>
          </div>
          <div class="flex items-start gap-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 mt-0.5 text-eden-forest shrink-0">
              <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" />
              <circle cx="12" cy="9" r="2.5" />
            </svg>
            <span>{event.location}</span>
          </div>
          <div class="flex items-start gap-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 mt-0.5 text-eden-forest shrink-0">
              <path d="M2 9l10-5 10 5-10 5L2 9z" />
              <path d="M6 11v5c0 2 3 4 6 4s6-2 6-4v-5" />
            </svg>
            <span>{event.admission}</span>
          </div>
        </div>
        <div class="mb-6">
          <h4 class="font-semibold text-eden-green mb-2">
            {event.isUpcoming ? "What You'll Find" : "Highlights"}
          </h4>
          <div class="flex flex-wrap gap-2">
            {event.highlights.map((item) => (
              <span class="bg-eden-sand text-eden-dark text-sm px-3 py-1 rounded-full">
                {item}
              </span>
            ))}
          </div>
        </div>
        <WhatsAppButton
          message={siteConfig.whatsapp.marketMessage}
          label="Ask About This Event"
        />
      </div>
    </div>
  </div>
</section>

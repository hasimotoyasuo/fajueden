---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.jpg";
import heroImage from "../assets/images/hero-kitchen-garden.jpg";
import { getWhatsAppUrl, siteConfig } from "../config/site";

const whatsappUrl = getWhatsAppUrl();
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <Image
    src={heroImage}
    alt="Faju Eden kitchen garden"
    widths={[640, 1024, 1536]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-eden-green/60"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <Image
      src={logo}
      alt="FAJU EDEN Logo"
      width={120}
      height={120}
      class="mx-auto mb-8 rounded-full border-2 border-eden-cream/30 shadow-2xl"
      loading="eager"
    />

    <h1 class="font-display text-4xl md:text-5xl lg:text-7xl text-eden-cream mb-4 leading-tight">
      Healthy Soil,<br />Healthy Products
    </h1>

    <p class="text-lg md:text-xl text-eden-cream/80 max-w-2xl mx-auto mb-10 leading-relaxed">
      From the heart of Kakamega, Kenya — organic farming rooted in
      sustainable soil, community, and care.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-semibold text-lg hover:bg-[#20bd5a] transition-all hover:scale-105 shadow-lg"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Order / Chat on WhatsApp
      </a>

      <a
        href="#products"
        class="inline-flex items-center gap-2 bg-eden-terra text-eden-cream px-8 py-3.5 rounded-full font-medium text-lg hover:bg-eden-terra/90 transition-all hover:scale-105"
      >
        Explore Our Farm
        <span class="text-xl">↓</span>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="h-6 w-6 text-eden-cream/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<section class="py-16 md:py-24 bg-eden-cream">
  <div class="mx-auto max-w-5xl px-4">
    <h2 class="font-display text-3xl md:text-4xl text-eden-green text-center mb-4">
      Gallery
    </h2>
    <p class="text-center text-eden-dark/60 mb-12 max-w-xl mx-auto">
      Photos from our events will be updated here.
      Stay tuned!
    </p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {Array.from({ length: 6 }).map((_, i) => (
        <div class="aspect-square bg-eden-sand rounded-xl flex items-center justify-center">
          <div class="text-center text-eden-dark/30">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 mx-auto mb-2">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <path d="M21 15l-5-5L5 21" />
            </svg>
            <span class="text-sm">Coming Soon</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

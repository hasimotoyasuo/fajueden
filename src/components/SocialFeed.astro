---
import { Image } from "astro:assets";
import { siteConfig, getWhatsAppUrl } from "../config/site";
import WhatsAppButton from "./WhatsAppButton.astro";
import logo from "../assets/images/logo.jpg";
import trainingLecture from "../assets/images/events/training-lecture.jpg";
import marketGroup from "../assets/images/events/market1-group.jpg";
import strawberryHarvest from "../assets/images/strawberry-harvest.jpg";
import mushroomInterior from "../assets/images/mushroom-hut-interior.jpg";

const whatsappUrl = getWhatsAppUrl();
---

<section id="social" class="py-16 md:py-24 bg-eden-sand/60">
  <div class="mx-auto max-w-6xl px-4">
    <div class="text-center mb-12">
      <span class="inline-block bg-eden-green/10 text-eden-green text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full mb-3">
        Live from the Farm
      </span>
      <h2 class="font-display text-3xl md:text-4xl text-eden-green mb-4">
        Follow FAJU EDEN on Social Media
      </h2>
      <p class="text-eden-dark/70 max-w-2xl mx-auto leading-relaxed">
        We regularly share harvest updates, farmers market announcements, and
        behind-the-scenes farm life on Instagram and Facebook.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- Instagram Dynamic Embed Card -->
      <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-eden-sand flex flex-col">
        <div class="p-4 md:p-5 bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] text-white flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-base leading-tight">Instagram</h3>
              <p class="text-xs text-white/90">{siteConfig.social.instagramHandle}</p>
            </div>
          </div>
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white text-xs font-semibold px-3.5 py-1.5 rounded-full transition-colors"
          >
            Follow →
          </a>
        </div>

        <div class="flex-grow bg-white min-h-[480px] flex flex-col">
          <iframe
            src="https://www.instagram.com/fajueden.037/embed"
            class="w-full flex-grow min-h-[480px] border-0"
            loading="lazy"
            title="FAJU EDEN Instagram Feed (@fajueden.037)"
            allowtransparency="true"
          ></iframe>
        </div>

        <div class="p-4 bg-eden-cream border-t border-eden-sand flex items-center justify-between gap-4">
          <span class="text-xs text-eden-dark/70">
            Latest photos & reels on {siteConfig.social.instagramHandle}
          </span>
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-eden-terra hover:underline shrink-0"
          >
            Open Instagram ↗
          </a>
        </div>
      </div>

      <!-- Facebook Dynamic Embed & Highlights Card -->
      <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-eden-sand flex flex-col">
        <div class="p-4 md:p-5 bg-[#1877F2] text-white flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-base leading-tight">Facebook</h3>
              <p class="text-xs text-white/90">FAJU EDEN — Kakamega, Kenya</p>
            </div>
          </div>
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white text-xs font-semibold px-3.5 py-1.5 rounded-full transition-colors"
          >
            Follow Page →
          </a>
        </div>

        <div class="p-5 flex-grow flex flex-col justify-between bg-white">
          <!-- Profile Header & Live Page Plugin -->
          <div>
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-eden-sand">
              <Image
                src={logo}
                alt="FAJU EDEN"
                width={48}
                height={48}
                class="rounded-full border border-eden-sand"
              />
              <div class="flex-grow">
                <h4 class="font-semibold text-eden-green">FAJU EDEN</h4>
                <p class="text-xs text-eden-dark/60">
                  Organic Farm · Healthy Soil, Healthy Products · Kakamega
                </p>
              </div>
              <a
                href={siteConfig.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 bg-[#1877F2]/10 text-[#1877F2] hover:bg-[#1877F2]/20 text-xs font-semibold px-3 py-1.5 rounded-full transition-colors"
              >
                View Timeline
              </a>
            </div>

            <!-- Facebook XFBML Timeline Widget (renders when browser allows third-party social plugins) -->
            <div class="w-full overflow-hidden rounded-xl mb-4 flex justify-center">
              <div
                class="fb-page w-full"
                data-href={siteConfig.social.facebook}
                data-tabs="timeline"
                data-width="500"
                data-height="220"
                data-small-header="true"
                data-adapt-container-width="true"
                data-hide-cover="false"
                data-show-facepile="true"
              ></div>
            </div>

            <!-- Recent Farm Updates Preview Grid (always visible even with strict browser tracking protection) -->
            <p class="text-xs font-semibold uppercase tracking-wider text-eden-dark/50 mb-3">
              Recent Activity Highlights
            </p>
            <div class="grid grid-cols-2 gap-3">
              <a
                href={siteConfig.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-xl overflow-hidden border border-eden-sand hover:shadow-sm transition-all"
              >
                <div class="aspect-[16/10] overflow-hidden">
                  <Image
                    src={trainingLecture}
                    alt="Mushroom Training with RICO FARM"
                    width={300}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-2.5 bg-eden-cream/60">
                  <span class="text-[11px] font-semibold text-eden-terra">Nov 5 · Workshop</span>
                  <p class="text-xs text-eden-dark font-medium line-clamp-1">
                    Mushroom Training × RICO FARM
                  </p>
                </div>
              </a>

              <a
                href={siteConfig.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-xl overflow-hidden border border-eden-sand hover:shadow-sm transition-all"
              >
                <div class="aspect-[16/10] overflow-hidden">
                  <Image
                    src={marketGroup}
                    alt="1st Kakamega Farmers Market"
                    width={300}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-2.5 bg-eden-cream/60">
                  <span class="text-[11px] font-semibold text-eden-terra">Oct 16–17 · Market</span>
                  <p class="text-xs text-eden-dark font-medium line-clamp-1">
                    1st Kakamega Farmers Market
                  </p>
                </div>
              </a>

              <a
                href={siteConfig.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-xl overflow-hidden border border-eden-sand hover:shadow-sm transition-all"
              >
                <div class="aspect-[16/10] overflow-hidden">
                  <Image
                    src={strawberryHarvest}
                    alt="Fresh Organic Strawberries"
                    width={300}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-2.5 bg-eden-cream/60">
                  <span class="text-[11px] font-semibold text-eden-forest">Harvest Update</span>
                  <p class="text-xs text-eden-dark font-medium line-clamp-1">
                    Sweet Organic Strawberries
                  </p>
                </div>
              </a>

              <a
                href={siteConfig.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-xl overflow-hidden border border-eden-sand hover:shadow-sm transition-all"
              >
                <div class="aspect-[16/10] overflow-hidden">
                  <Image
                    src={mushroomInterior}
                    alt="Oyster Mushroom Cultivation"
                    width={300}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-2.5 bg-eden-cream/60">
                  <span class="text-[11px] font-semibold text-eden-forest">Mushroom Hut</span>
                  <p class="text-xs text-eden-dark font-medium line-clamp-1">
                    Fresh Oyster Mushrooms
                  </p>
                </div>
              </a>
            </div>
          </div>
        </div>

        <div class="p-4 bg-eden-cream border-t border-eden-sand flex items-center justify-between gap-4">
          <span class="text-xs text-eden-dark/70">
            Follow our Facebook page for community updates & photos
          </span>
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-[#1877F2] hover:underline shrink-0"
          >
            Open Facebook ↗
          </a>
        </div>
      </div>
    </div>

    <!-- High-Conversion WhatsApp Banner below Social Feeds -->
    <div class="mt-10 bg-eden-green rounded-2xl p-6 md:p-8 text-eden-cream shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-center md:text-left">
        <div class="inline-flex items-center gap-2 text-eden-terra bg-eden-cream/10 px-3 py-1 rounded-full text-xs font-semibold mb-2">
          <span>Direct Farm Order & Inquiry</span>
          <span>·</span>
          <span>{siteConfig.whatsapp.displayNumber}</span>
        </div>
        <h3 class="font-display text-2xl md:text-3xl mb-2">
          Saw Something Fresh on Our Feed?
        </h3>
        <p class="text-eden-cream/80 text-sm md:text-base max-w-xl">
          Message us directly on WhatsApp to order fresh strawberries, oyster
          mushrooms, organic vegetables, or ask about our next market & training!
        </p>
      </div>
      <div class="shrink-0">
        <WhatsAppButton
          message={siteConfig.whatsapp.defaultMessage}
          label={`WhatsApp Us (${siteConfig.whatsapp.displayNumber})`}
          variant="light"
        />
      </div>
    </div>
  </div>
</section>

<div id="fb-root"></div>
<script is:inline async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v21.0"></script>

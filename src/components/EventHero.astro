---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.jpg";
---

<section class="relative bg-eden-green py-24 md:py-32">
  <div class="absolute inset-0 bg-gradient-to-br from-eden-green via-eden-forest to-eden-green opacity-90"></div>
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <Image
      src={logo}
      alt="FAJU EDEN Logo"
      width={80}
      height={80}
      class="mx-auto mb-6 rounded-full border-2 border-eden-cream/30"
    />
    <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-eden-cream mb-4">
      Events
    </h1>
    <p class="text-lg md:text-xl text-eden-cream/80 max-w-2xl mx-auto">
      Farm tours, farmers markets, workshops, and more —
      join us in the field and experience organic farming firsthand.
    </p>
  </div>
</section>

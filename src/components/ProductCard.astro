---
import WhatsAppButton from "./WhatsAppButton.astro";
import { getWhatsAppUrl } from "../config/site";
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col">
  <div class="w-10 h-10 mb-4 text-eden-forest">
    {product.category === "fruit" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
        <path d="M12 2c-1 0-2 .5-2.5 1.5S9 5.5 9 7c-2 0-4 1-5 3s-1 4.5 0 6.5 3 3.5 5 4 4.5.5 6.5-.5 3.5-3 4-5 .5-4.5-.5-6.5S14 4 12 2z" />
        <path d="M12 2c0 2 .5 4 2 5.5" />
      </svg>
    )}
    {product.category === "mushroom" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
        <path d="M4 13c0-5 3.5-9 8-9s8 4 8 9H4z" />
        <path d="M9 13v7c0 1 1 2 3 2s3-1 3-2v-7" />
      </svg>
    )}
    {product.category === "vegetable" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
        <path d="M17 8c1-3-1-5-4-6-3 1-5 3-4 6" />
        <path d="M6 22c0-6 2-10 6-12 4 2 6 6 6 12" />
        <path d="M12 10v12" />
      </svg>
    )}
    {product.category === "fish" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
        <path d="M2 12c3-4 7-6 12-6 2 0 4 1 6 2l-3 4 3 4c-2 1-4 2-6 2-5 0-9-2-12-6z" />
        <circle cx="16" cy="12" r="1" fill="currentColor" />
      </svg>
    )}
    {product.category === "livestock" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
        <path d="M4 7c1-2 3-3 5-3 1 0 2 1 3 2 1-1 2-2 3-2 2 0 4 1 5 3" />
        <ellipse cx="12" cy="13" rx="8" ry="6" />
        <path d="M8 19v3M16 19v3" />
      </svg>
    )}
  </div>
  <h3 class="font-display text-xl text-eden-green mb-2">{product.name}</h3>
  <p class="text-eden-dark/70 text-sm leading-relaxed mb-4 flex-grow">
    {product.description}
  </p>
  {product.price && (
    <p class="text-eden-terra font-semibold mb-4">{product.price}</p>
  )}
  <WhatsAppButton
    message={product.whatsappMessage}
    label="Order via WhatsApp"
  />
</div>

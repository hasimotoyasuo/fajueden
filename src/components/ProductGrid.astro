---
import ProductCard from "./ProductCard.astro";
import { products } from "../data/products";
---

<section id="products" class="py-16 md:py-24 bg-eden-cream">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="font-display text-3xl md:text-4xl text-eden-green text-center mb-4">
      What We Grow
    </h2>
    <p class="text-center text-eden-dark/60 max-w-2xl mx-auto mb-12">
      From kitchen gardens to fish ponds, we're growing a diverse range of
      organic products. Every item is cultivated with care using sustainable
      practices.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <!-- Additional crops teaser -->
    <div class="mt-12 text-center">
      <div class="inline-flex flex-wrap justify-center gap-3">
        <span class="inline-flex items-center gap-2 bg-eden-sand text-eden-dark/70 text-sm px-4 py-2 rounded-full">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 2v3M12 7c0 2-1 3-2 4" />
          </svg>
          Apples — Coming Soon
        </span>
        <span class="inline-flex items-center gap-2 bg-eden-sand text-eden-dark/70 text-sm px-4 py-2 rounded-full">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M4 7c1-2 3-3 5-3 1 0 2 1 3 2 1-1 2-2 3-2 2 0 4 1 5 3" />
            <ellipse cx="12" cy="13" rx="8" ry="6" />
            <path d="M8 19v3M16 19v3" />
          </svg>
          Livestock
        </span>
        <span class="inline-flex items-center gap-2 bg-eden-sand text-eden-dark/70 text-sm px-4 py-2 rounded-full">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M12 22c-4 0-7-2-7-5 0-2 1-3 3-4l4-3 4 3c2 1 3 2 3 4 0 3-3 5-7 5z" />
            <path d="M12 12V8M9 6c0-2 1-4 3-4s3 2 3 4" />
          </svg>
          Vermicompost
        </span>
      </div>
    </div>
  </div>
</section>
